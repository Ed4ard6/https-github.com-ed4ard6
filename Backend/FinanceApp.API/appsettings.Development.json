{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=finance_app.db"
  },
  "Jwt": {
    "Key": "${JWT_KEY:-default-dev-key-change-in-production}",
    "Issuer": "finance-app",
    "Audience": "finance-app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
